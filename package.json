{
  "name": "yamaha-style-velocity-editor",
  "version": "1.1.0",
  "description": "Browser-based piano roll to edit velocity, pitch and length inside Yamaha .STY style files. Pure client-side, no server.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "npx --yes serve -l 5173 .",
    "test:browser": "node test/run-browser.mjs"
  },
  "keywords": [
    "yamaha",
    "sty",
    "sff",
    "velocity",
    "midi",
    "genos",
    "psr-a5000",
    "drum",
    "piano-roll"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}

